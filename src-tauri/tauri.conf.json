{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "0.1.10",
  "productName": "Chechevica",
  "identifier": "io.chechevica.app",
  "build": {
    "beforeDevCommand": "pnpm ui:dev",
    "beforeBuildCommand": "pnpm ui:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/projects/**"]
      }
    },
    "windows": [
      {
        "title": "Chechevica",
        "width": 800,
        "height": 600,
        "center": true,
        "decorations": false,
        "backgroundColor": "#000"
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "targets": ["msi"],
    "externalBin": ["bin/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCMkM4RkE0NzkyQjIwMTMKUldRVElDdDVwSThzbTJ0b2htQk5ObllvMThhaUlXTkJKbVBNZ01rTmcwS1ZqaDUzSk9BRUt5RHIK",
      "endpoints": [
        "https://github.com/rookhive/chechevica/releases/latest/download/latest.cpu.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
